{
  "name": "agent-skills-evals",
  "private": true,
  "description": "Local eval suite for the skills in this repo. Not published; not part of any skill package.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "clean:hard": "node scripts/hard-clean.ts",
    "clean:soft": "node scripts/soft-clean.ts",
    "eval": "node src/orchestration/run.ts",
    "fix": "run-s --continue-on-error \"fix:*\"",
    "fix:eslint": "eslint --cache --cache-location node_modules/.cache/eslint --fix .",
    "fix:oxfmt": "oxfmt --write",
    "fix:oxlint": "oxlint --fix",
    "lint": "run-p --continue-on-error \"lint:*\"",
    "lint:eslint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:oxfmt": "oxfmt --check",
    "lint:oxlint": "oxlint",
    "lint:types": "tsc --build --pretty",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "9.39.5",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.13.3",
    "@vitest/eslint-plugin": "1.6.24",
    "effect": "4.0.0-beta.102",
    "eslint": "9.39.5",
    "eslint-config-love": "154.1.0",
    "eslint-plugin-oxlint": "1.76.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "globals": "17.8.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
