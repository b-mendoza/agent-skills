{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // `report.md` is generated by `run.ts`, which emits an unaligned table.
  // Formatting it here would make every eval run show a spurious diff.
  "ignorePatterns": ["node_modules/", "report.md"],
  "printWidth": 80,
  "sortPackageJson": {
    "sortScripts": true
  }
}
